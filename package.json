{
  "name": "dsh-skills-ppt",
  "version": "0.1.0",
  "description": "PPT skill pack for DeepSeek Harness: bundles the ppt-master workflow as a runtime skill, so any PPT request loads it on demand.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skill",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "skill",
    "ppt",
    "pptx",
    "powerpoint",
    "slides",
    "presentation"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
